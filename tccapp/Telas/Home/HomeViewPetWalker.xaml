<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tccapp.Telas.Home.HomeViewPetWalker"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#304E61"
             Title="HomeViewPetWalker">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,40,20,15">

        <!-- Cabeçalho -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" HorizontalOptions="Center" Margin="0,10,0,15">
            <Border BackgroundColor="White"
                    WidthRequest="76"
                    HeightRequest="76"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 38"
                    HorizontalOptions="Center"
                    Padding="12">
                <Image Source="logo.png" Aspect="AspectFit" />
            </Border>

            <Label Text="Área do Petwalker"
                   TextColor="White"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Área Central -->
        <VerticalStackLayout Grid.Row="1" Spacing="16" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="340">

            <!-- Card Disponível -->
            <Border BackgroundColor="White"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
                        <Label Text="Disponível"
                               TextColor="#304E61"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />

                        <Switch x:Name="SwitchDisponibilidade"
                                Toggled="SwitchDisponibilidade_Toggled"
                                OnColor="#2F6B8E"
                                ThumbColor="White"
                                VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <ActivityIndicator IsRunning="{Binding Carregando}"
                                       IsVisible="{Binding Carregando}"
                                       Color="#2F6B8E"
                                       HeightRequest="24" />
                </VerticalStackLayout>
            </Border>

            <!-- Card de Notificação de Novo Passeio -->
            <Border IsVisible="{Binding TemSolicitacaoPendente}"
                    BackgroundColor="White"
                    Stroke="#FFB300"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Nova Solicitação de Passeio"
                           TextColor="#304E61"
                           FontSize="17"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" Color="#E1E8ED" />

                    <Label Text="{Binding SolicitacaoAtual.DonoNome, StringFormat='Dono: {0}'}"
                           TextColor="#212121"
                           FontSize="14"
                           FontAttributes="Bold" />

                    <Label Text="{Binding SolicitacaoAtual.PetNome, StringFormat='Pet: {0}'}"
                           TextColor="#212121"
                           FontSize="14" />

                    <Label Text="{Binding SolicitacaoAtual.Duracao, StringFormat='Duração: {0} minutos'}"
                           TextColor="#2F6B8E"
                           FontSize="14"
                           FontAttributes="Bold" />

                    <Label Text="{Binding TextoLocalizacao, StringFormat='Local: {0}'}"
                           TextColor="#404040"
                           FontSize="13" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                        <Button Grid.Column="0"
                                Text="Recusar"
                                BackgroundColor="#D9534F"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="40"
                                Command="{Binding RecusarSolicitacaoCommand}" />

                        <Button Grid.Column="1"
                                Text="Aceitar"
                                BackgroundColor="#2F6B8E"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="40"
                                Command="{Binding AceitarSolicitacaoCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

        <!-- Barra Inferior -->
        <Border Grid.Row="2"
                Margin="0,20,0,5"
                WidthRequest="362"
                HeightRequest="50"
                BackgroundColor="White"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 12"
                HorizontalOptions="Center">
            <Grid ColumnDefinitions="*,*,*" VerticalOptions="Center" Padding="20,0">
                <Image Grid.Column="0" Source="relogio.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" />
                <Image Grid.Column="1" Source="logo.png" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" />
                <Image Grid.Column="2" Source="generic_avatar1.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>