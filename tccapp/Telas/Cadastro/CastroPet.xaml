<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tccapp.Telas.Cadastro.CastroPet"
             Title="CastroPet">
    <Grid RowDefinitions="Auto,*" RowSpacing="20">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="3" Padding="15">
                <HorizontalStackLayout  Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Cadastre seu amiguinho"
                       FontSize="48"
                       FontAttributes="Bold"
                       TextColor="#1A1A1A"
                       HorizontalOptions="Center"
                       />
                </HorizontalStackLayout>
                <Image Source="pet.png" HeightRequest="160" WidthRequest="160" />
            </VerticalStackLayout>
        </ScrollView>
        <Border
            Grid.Row="1"
            BackgroundColor="#304E61"
            StrokeShape="RoundRectangle 30,30,0,0"
            Stroke="Transparent"
            Padding="25,40">
            <Grid RowDefinitions="*,Auto,Auto" RowSpacing="20">
                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Spacing="15">
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="Transparent">
                            <Grid Margin="10,0">
                                <Label x:Name="LabelTipo"
                                       Text="{Binding PorteExibido}"
                                       TextColor="{Binding PorteTextColor}"
                                       VerticalOptions="Center" 
                                       InputTransparent="True"/>

                                <Picker x:Name="PickerTipo"
                                        ItemsSource="{Binding Porte}"
                                        SelectedItem="{Binding PorteSelecionado}"
                                        Opacity="0"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Fill" />
                            </Grid>
                        </Border>
                        <Border
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        Stroke="Transparent">
                            <Entry Placeholder="Nome"
                               Text="{Binding Nome}"
                               MaxLength="150"
                               PlaceholderColor="#999999"
                               BackgroundColor="Transparent"
                               TextColor="Black"
                               VerticalOptions="Center"
                               Margin="10,0"/>
                        </Border>
                        <Border
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent">
                            <Entry Placeholder="Rga"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   PlaceholderColor="#999999"
                                   BackgroundColor="Transparent"
                                   TextColor="Black"
                                   VerticalOptions="Center"
                                   Margin="10,0"/>
                        </Border>
                        <Border
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent">
                            <Entry Placeholder="Especie"
                                   Text="{Binding Telefone}"
                                   Keyboard="Telephone"
                                   MaxLength="11"
                                   PlaceholderColor="#999999"
                                   BackgroundColor="Transparent"
                                   TextColor="Black"
                                   VerticalOptions="Center"
                                   Margin="10,0"/>
                        </Border>
                        <Border
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent">
                            <Entry Placeholder="Raça"
                                   Text="{Binding Cep}"
                                   MaxLength="8"
                                   Keyboard="Numeric"
                                   PlaceholderColor="#999999"
                                   BackgroundColor="Transparent"
                                   TextColor="Black"
                                   VerticalOptions="Center"
                                   Margin="10,0"/>
                        </Border>
                        <Border
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent">
                            <Entry Placeholder="Peso em kg"
                                   Text="{Binding Cpf}"
                                   Keyboard="Numeric"
                                   MaxLength="11"
                                   PlaceholderColor="#999999"
                                   BackgroundColor="Transparent"
                                   TextColor="Black"
                                   VerticalOptions="Center"
                                   Margin="10,0"/>
                        </Border>
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="Transparent">
                            <Grid Margin="10,0">
                                <Label x:Name="LabelGenero"
                                       Text="{Binding GeneroExibido}"
                                       TextColor="{Binding GeneroTextColor}"
                                       VerticalOptions="Center" 
                                       InputTransparent="True"/>

                                <Picker x:Name="PickerGenero"
                                        ItemsSource="{Binding Generos}"
                                        SelectedItem="{Binding GeneroSelecionado}"
                                        Opacity="0"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Fill" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                </ScrollView>
                <Image Grid.Row="1" Source="sombra.png" HeightRequest="17" WidthRequest="300" HorizontalOptions="Center"/>
                <StackLayout  Grid.Row="2">
                    <Button Text="Salvar"
                            Command="{Binding RegistrarCommand}"
                            Grid.Row="0"
                            BackgroundColor="#2B3033"
                            TextColor="White"
                            FontSize="16"
                            CornerRadius="12"
                            WidthRequest="150"
                             HeightRequest="50"/>
                    <Label Text="{Binding ErrorMessage}"
                       TextColor="#FF6B6B"
                       FontSize="14"
                       HorizontalOptions="Center"
                       IsVisible="{Binding HasError}" />
                </StackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>