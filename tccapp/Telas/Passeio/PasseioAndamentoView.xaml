<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="tccapp.Telas.Passeios.PasseioAndamentoView"
             Shell.NavBarIsVisible="False"
             Title="PasseioAndamentoView">

    <Grid>

        <!-- Mapa ocupando 100% do fundo -->
        <mapsui:MapControl Map="{Binding Map}" />

        <!-- Indicador de carregamento -->
        <ActivityIndicator IsRunning="{Binding Carregando}"
                           IsVisible="{Binding Carregando}"
                           Color="#2F6B8E"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <!-- Bloco inferior sobreposto ao mapa -->
        <VerticalStackLayout VerticalOptions="End" Spacing="10" Padding="16,0,16,8">

            <!-- Card Flutuante Principal -->
            <Border BackgroundColor="White"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 16"
                    Padding="0">
                <VerticalStackLayout Spacing="0">

                    <!-- Cabeçalho Escuro (#304E61): Minutos (Chegada estimada ou Restantes) -->
                    <Grid BackgroundColor="#304E61" Padding="20,14" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                                <Label Text="{Binding TempoPrincipalTexto}"
                                       FontSize="30"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="min"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       VerticalOptions="End"
                                       Margin="0,0,0,4" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding SubtituloTempoTexto}"
                                   FontSize="13"
                                   TextColor="#D0DCE3"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="☰"
                               FontSize="22"
                               TextColor="White"
                               VerticalOptions="Center"
                               IsVisible="{Binding MostrarMenuOpcoes}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AbrirMenuPasseioCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Corpo Branco do Card -->
                    <VerticalStackLayout Padding="20,16" Spacing="14">

                        <!-- Conteúdo FASE 1: Petwalker indo até o Dono -->
                        <VerticalStackLayout IsVisible="{Binding IsIndoAteDono}" Spacing="4" HorizontalOptions="Center">
                            <Label Text="{Binding TituloStatusDeslocamento}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="#304E61"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding EnderecoDestinoTexto}"
                                   FontSize="13"
                                   TextColor="#6E6E6E"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Conteúdo FASE 2: Passeio em Andamento (igual ao mockup) -->
                        <VerticalStackLayout IsVisible="{Binding IsEmAndamento}" Spacing="2" HorizontalOptions="Center">
                            <Label Text="Distância percorrida:"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="#304E61"
                                   HorizontalOptions="Center" />
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding DistanciaPercorridaTexto}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#304E61" />
                                <Label Text="Km"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#304E61" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Linha do Usuário (Avatar + Nome + Telefone) -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,4,0,0">
                            <Image Grid.Column="0"
                                   Source="generic_avatar.png"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   VerticalOptions="Center" />

                            <Label Grid.Column="1"
                                   Text="{Binding NomeExibicao}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   TextColor="#212121" />

                            <Border Grid.Column="2"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#304E61"
                                    StrokeThickness="1.5"
                                    BackgroundColor="Transparent">
                                <Label Text="📞"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="18" />
                            </Border>
                        </Grid>

                        <!-- Botão exclusivo do Petwalker: Iniciar Passeio (cinza enquanto longe, azul ao chegar) -->
                        <Button IsVisible="{Binding MostrarBotaoIniciar}"
                                IsEnabled="{Binding PodeIniciarPasseio}"
                                Text="{Binding TextoBotaoIniciar}"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="42"
                                Command="{Binding IniciarPasseioCommand}">
                            <Button.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="VisualStateManager.VisualStateGroups">
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#2F6B8E" />
                                                        <Setter Property="TextColor" Value="White" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Disabled">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#9E9E9E" />
                                                        <Setter Property="TextColor" Value="#E0E0E0" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </Setter>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Botão exclusivo do Petwalker: Finalizar Passeio -->
                        <Button IsVisible="{Binding MostrarBotaoFinalizar}"
                                Text="Finalizar Passeio"
                                BackgroundColor="#D9534F"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="42"
                                Command="{Binding FinalizarPasseioCommand}" />

                        <Label Text="{Binding Mensagem}"
                               TextColor="#B00020"
                               FontSize="12"
                               HorizontalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding Mensagem}"
                                             Value="">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding Mensagem}"
                                             Value="{x:Null}">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Barra Inferior (padrão do mockup) -->
            <Border HeightRequest="50"
                    BackgroundColor="White"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 12">
                <Grid ColumnDefinitions="*,*,*,*,*" VerticalOptions="Center" Padding="16,0">
                    <Image Grid.Column="0" Source="menu_hamburguer.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoltarParaHomeCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image Grid.Column="1" Source="pet.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoltarParaHomeCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                    <!-- Ícone central: já está na tela do passeio -->
                    <Image Grid.Column="2" Source="logo.png" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" />
                    <Image Grid.Column="3" Source="relogio.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoltarParaHomeCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image Grid.Column="4" Source="generic_avatar1.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoltarParaHomeCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>
            </Border>

        </VerticalStackLayout>

    </Grid>
</ContentPage>